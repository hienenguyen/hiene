rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // 1. GLOBAL HELPERS
    // ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // ---------------------------------------------------------
    // 2. ENTITY VALIDATION
    // ---------------------------------------------------------
    
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'currentCourseId'])
        && data.id is string && data.id == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.currentCourseId is string && data.currentCourseId.size() <= 128
        && (data.get('totalFees', 0) is number && data.get('totalFees', 0) >= 0)
        && data.updatedAt == request.time;
    }
    
    function isValidCourse(data) {
      return data.keys().hasAll(['courseNumber', 'startDate', 'sessions', 'isCompleted'])
        && data.courseNumber is number && data.courseNumber >= 0
        && data.startDate is string // date-time string
        && data.sessions is list && data.sessions.size() <= 8
        && data.isCompleted is bool
        && (!data.keys().contains('fee') || (data.fee is number && data.fee >= 0))
        && (!data.keys().contains('updatedAt') || data.updatedAt == request.time);
    }

    // ---------------------------------------------------------
    // 3. MATCH BLOCKS
    // ---------------------------------------------------------
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().keys().size() <= 6;
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['currentCourseId', 'totalFees', 'updatedAt', 'email'])
      );
      
      // Courses Subcollection
      match /courses/{courseId} {
        allow list, get: if isOwner(userId);
        
        allow create: if isOwner(userId) 
          && isValidId(courseId)
          && isValidCourse(incoming())
          && exists(/databases/$(database)/documents/users/$(userId));
          
        allow update: if isOwner(userId)
          && isValidId(courseId)
          && isValidCourse(incoming())
          && (
            // Prevent changing course number or start date after creation if desired
            incoming().courseNumber == existing().courseNumber &&
            incoming().startDate == existing().startDate &&
            (
              // Action: Progress (adding sessions or marking completed)
              incoming().diff(existing()).affectedKeys().hasAny(['sessions', 'isCompleted', 'completionDate', 'fee', 'updatedAt'])
            )
          );
          
        allow delete: if isOwner(userId);
      }
    }
  }
}
